# Optional service: local reviewed model snapshot; no automatic download.
TELEOCR_MODEL_PATH=
TELEOCR_BACKEND=transformers
TELEOCR_SERVICE_TOKEN=
TELEOCR_MAX_IMAGE_BYTES=5242880
TELEOCR_MAX_IMAGE_PIXELS=4000000
TELEOCR_QUEUE_WAIT_SECONDS=2
# Leave MT empty for /ocr only. Cloud MT sends recognized TEXT to the provider.
MT_BASE_URL=
MT_MODEL=
MT_API_KEY=
MT_TIMEOUT_SECONDS=45
