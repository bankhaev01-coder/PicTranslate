# ── General ─────────────────────────────────────────────
# "cloud" (OpenAI/Gemini/custom) | "local" (Tesseract via Docker)
DEFAULT_MODE=local

# ── OpenAI (quality OCR + translation in one call) ──────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ── Gemini Vision ───────────────────────────────────────
 GEMINI_API_KEY=
# Current model ids: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# ── Custom — your own neural network REST API ───────────
# Expected: POST multipart image(file) + target_lang(str) -> {translation, source_text?}
# CUSTOM_API_KEY (if set) is sent as the API key header.
CUSTOM_API_URL=http://host.docker.internal:8001/predict
CUSTOM_API_KEY=
CUSTOM_MODEL_NAME=custom

# ── Local OCR (Tesseract, inside image) ────────────────
# tesseract is installed in the Docker image automatically.
# For local dev outside Docker you also need system tesseract + lang packs.
# Tesseract language codes joined with "+" (each needs an installed traineddata).
TESSERACT_LANG=rus+eng
OCR_DPI=300

# ── Translation provider when OCR is local (tesseract)
# "none" = don’t translate (only OCR, for debugging)
# "openai"|"gemini"|"custom" = also run translation (needs that provider's key/URL above)
LOCAL_TRANSLATION_PROVIDER=openai

# ── Cache ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
USE_FILE_CACHE_IF_NO_REDIS=true
CACHE_TTL_SECONDS=86400

# ── CORS (chrome-extension origins; comma separated) ───
# Find your extension id from chrome://extensions in dev mode.
# Use "chrome-extension://<id>" or wildcard "chrome-extension://*"
ALLOWED_ORIGINS=chrome-extension://*,http://localhost:5173,http://localhost:9000,http://localhost:3000

# ── Limits ──────────────────────────────────────────────
# 5 MB
MAX_IMAGE_BYTES=5242880
OCR_TIMEOUT_SECONDS=60
TRANSLATE_TIMEOUT_SECONDS=60
